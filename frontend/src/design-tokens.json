{
  "$schema": "https://design-tokens.github.io/community-group/format.json",
  "mna-design-system": {
    "color": {
      "primary": {
        "accent": {
          "$type": "color",
          "$value": "#2B7A78",
          "$description": "Main teal accent color for primary actions and branding"
        },
        "secondary": {
          "$type": "color",
          "$value": "#4BA3C7",
          "$description": "Soft blue for secondary accents"
        }
      },
      "neutral": {
        "dark": {
          "$type": "color",
          "$value": "#0B2440",
          "$description": "Primary text color on light backgrounds"
        },
        "mid": {
          "$type": "color",
          "$value": "#51666A",
          "$description": "Secondary text and muted elements"
        },
        "light": {
          "$type": "color",
          "$value": "#D1D5DB",
          "$description": "Borders and dividers"
        }
      },
      "background": {
        "page": {
          "$type": "color",
          "$value": "#F6F7FB",
          "$description": "Main page background"
        },
        "surface": {
          "$type": "color",
          "$value": "#FFFFFF",
          "$description": "Card and elevated surface backgrounds"
        }
      },
      "semantic": {
        "success": {
          "$type": "color",
          "$value": "#2FAF9B",
          "$description": "Success states and confirmations"
        },
        "error": {
          "$type": "color",
          "$value": "#E45A5A",
          "$description": "Error states and destructive actions"
        },
        "warning": {
          "$type": "color",
          "$value": "#F59E0B",
          "$description": "Warning states and cautions"
        },
        "info": {
          "$type": "color",
          "$value": "#4BA3C7",
          "$description": "Informational messages"
        }
      }
    },
    "typography": {
      "font-family": {
        "base": {
          "$type": "fontFamily",
          "$value": "'Inter', 'Segoe UI', 'Roboto', Arial, sans-serif",
          "$description": "Primary font stack"
        }
      },
      "font-size": {
        "h1": {
          "$type": "dimension",
          "$value": "32px",
          "$description": "Page titles"
        },
        "h2": {
          "$type": "dimension",
          "$value": "24px",
          "$description": "Section headings"
        },
        "h3": {
          "$type": "dimension",
          "$value": "18px",
          "$description": "Card titles"
        },
        "body": {
          "$type": "dimension",
          "$value": "16px",
          "$description": "Body text"
        },
        "small": {
          "$type": "dimension",
          "$value": "14px",
          "$description": "Helper text"
        },
        "xs": {
          "$type": "dimension",
          "$value": "13px",
          "$description": "Labels and badges"
        }
      },
      "font-weight": {
        "normal": {
          "$type": "number",
          "$value": 400,
          "$description": "Regular body text"
        },
        "medium": {
          "$type": "number",
          "$value": 500,
          "$description": "Emphasized text and UI elements"
        },
        "semibold": {
          "$type": "number",
          "$value": 600,
          "$description": "Headings and important text"
        }
      },
      "line-height": {
        "tight": {
          "$type": "number",
          "$value": 1.3,
          "$description": "Headings"
        },
        "normal": {
          "$type": "number",
          "$value": 1.5,
          "$description": "Body text"
        },
        "relaxed": {
          "$type": "number",
          "$value": 1.6,
          "$description": "Long-form content"
        }
      }
    },
    "spacing": {
      "1": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Tight spacing"
      },
      "2": {
        "$type": "dimension",
        "$value": "8px",
        "$description": "Base unit (8px grid)"
      },
      "3": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Small gaps"
      },
      "4": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Card padding, standard gaps"
      },
      "5": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "Section spacing"
      },
      "6": {
        "$type": "dimension",
        "$value": "32px",
        "$description": "Large gaps"
      },
      "7": {
        "$type": "dimension",
        "$value": "40px",
        "$description": "Extra large gaps"
      },
      "8": {
        "$type": "dimension",
        "$value": "64px",
        "$description": "Major section breaks"
      }
    },
    "border-radius": {
      "sm": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Small elements (badges)"
      },
      "md": {
        "$type": "dimension",
        "$value": "6px",
        "$description": "Medium elements"
      },
      "lg": {
        "$type": "dimension",
        "$value": "8px",
        "$description": "Default (cards, buttons)"
      },
      "xl": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Large containers"
      },
      "full": {
        "$type": "dimension",
        "$value": "9999px",
        "$description": "Circular (avatars, pills)"
      }
    },
    "shadow": {
      "sm": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.05)"
        },
        "$description": "Subtle elevation"
      },
      "md": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "6px",
          "spread": "-1px",
          "color": "rgba(0, 0, 0, 0.1)"
        },
        "$description": "Cards"
      },
      "lg": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0px",
          "offsetY": "10px",
          "blur": "15px",
          "spread": "-3px",
          "color": "rgba(0, 0, 0, 0.1)"
        },
        "$description": "Modals, popovers"
      },
      "xl": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0px",
          "offsetY": "20px",
          "blur": "25px",
          "spread": "-5px",
          "color": "rgba(0, 0, 0, 0.1)"
        },
        "$description": "Large elevated surfaces"
      }
    },
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "150ms",
        "$description": "Hover states, quick transitions"
      },
      "normal": {
        "$type": "duration",
        "$value": "220ms",
        "$description": "Modal entrance, standard animations"
      },
      "slow": {
        "$type": "duration",
        "$value": "300ms",
        "$description": "Complex animations"
      }
    },
    "easing": {
      "ease-out": {
        "$type": "cubicBezier",
        "$value": [0, 0, 0.2, 1],
        "$description": "Standard easing for most transitions"
      }
    },
    "breakpoints": {
      "mobile": {
        "$type": "dimension",
        "$value": "0px",
        "$description": "Mobile devices"
      },
      "tablet": {
        "$type": "dimension",
        "$value": "768px",
        "$description": "Tablet devices"
      },
      "desktop": {
        "$type": "dimension",
        "$value": "1024px",
        "$description": "Desktop screens"
      },
      "wide": {
        "$type": "dimension",
        "$value": "1440px",
        "$description": "Wide screens"
      }
    },
    "layout": {
      "max-content-width": {
        "$type": "dimension",
        "$value": "1200px",
        "$description": "Maximum width for content containers"
      },
      "header-height": {
        "$type": "dimension",
        "$value": "64px",
        "$description": "Global header height"
      }
    }
  }
}
